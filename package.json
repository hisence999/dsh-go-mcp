{
  "name": "dsh-go-mcp",
  "version": "0.1.0",
  "description": "MCP server manager for the dsh-go phone app, drawn as native panels.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hisence999/dsh-go-mcp.git"
  },
  "homepage": "https://github.com/hisence999/dsh-go-mcp#readme",
  "bugs": {
    "url": "https://github.com/hisence999/dsh-go-mcp/issues"
  },
  "author": "hisence999",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "dsh",
    "dsh-go",
    "mcp",
    "cordis",
    "dsh-go-plugin",
    "deepseek-harness"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "MCP 管理",
      "en": "MCP manager"
    },
    "icon": "server",
    "wants": [
      "clipboard"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "open-servers",
          "label": {
            "zh": "MCP 管理",
            "en": "MCP"
          },
          "icon": "server",
          "effect": [
            {
              "type": "open",
              "page": "panel:servers"
            }
          ]
        }
      ],
      "panels": [
        {
          "id": "servers",
          "title": {
            "zh": "MCP 服务器",
            "en": "MCP servers"
          },
          "icon": "server",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "detail",
          "title": {
            "zh": "服务器详情",
            "en": "Server detail"
          },
          "icon": "plugin",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "add",
          "title": {
            "zh": "添加服务器",
            "en": "Add server"
          },
          "icon": "add",
          "placement": [
            "session.tab",
            "features"
          ]
        },
        {
          "id": "tools",
          "title": {
            "zh": "工具清单",
            "en": "Tool inventory"
          },
          "icon": "tool",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
